namespace FripuckProtocol.Commands;

table Custom {
    topic: string; // MQTT inspired, like foo/bar
    payload: string; // anything but text, optional
}

enum ModuleMask : uint32 {
    None = 0,
    ModeSelector = 1,
    IrReceiver = 2,
    Battery = 4,
    Led1 = 8,
    Led3 = 16,
    Led5 = 32,
    Led7 = 64,
    BodyLed = 128,
    FrontLed = 256,
    Proximity = 512,
    Tof = 1024,
    Imu = 2048,
    Camera = 4096,
    Motors = 8192,
    Ground = 16384
}

table EnableCommand {
    enable_mask: ModuleMask = 0;
    disable_mask: ModuleMask = 0;
}

table MoveTrajectory {
    speed: float;
    distance: float;
    radius: float;
    accel: float;
    decel: float;
    notify: bool;
    synchronous: bool;
}

table FileTransfer {
    filename: string;
    content: [uint8];
    selector_slot: int8 = -1; // -1 = module, 0-15 = boot slot
}

union Instruction {
    Custom,
    EnableCommand,
    MoveTrajectory,
    FileTransfer
}

// Needed since flatbuffers doesn't support vectors of unions.
table Command {
    command: Instruction;
}

table CommandBatch {
    timestamp: uint64;
    commands: [Command];
}

root_type CommandBatch;
