namespace FripuckProtocol.Commands;

table Custom {
    topic: string; // MQTT inspired, like foo/bar
    payload: string; // anything but text, optional
}

enum ModuleMask : uint32 {
    None = 0,
    ModeSelector = 1,
    IrReceiver = 2,
    Battery = 4,
    Led1 = 8,
    Led3 = 16,
    Led5 = 32,
    Led7 = 64,
    BodyLed = 128,
    FrontLed = 256,
    Proximity = 512,
    Tof = 1024,
    Imu = 2048,
    Camera = 4096,
    Motors = 8192,
    Ground = 16384
}

table EnableCommand {
    enable_mask: ModuleMask = 0;
    disable_mask: ModuleMask = 0;
}

table MoveTrajectory {
    speed: float;
    distance: float;
    radius: float;
    accel: float;
    decel: float;
    notify: bool;
    synchronous: bool;
}

table FileTransfer {
    filename: string;
    content: [uint8];
    selector_slot: int8 = -1; // -1 = module, 0-15 = boot slot
}

enum PlayMode : uint8 {
    IfFree = 0,
    Replace = 1,
    Queue = 2
}

table PlaySound {
    mml: string (required);
    mode: PlayMode = Replace;
}

enum LedTarget : ubyte {
    RING_1 = 1,
    RING_2 = 2,
    RING_3 = 3,
    RING_4 = 4,
    RING_5 = 5,
    RING_6 = 6,
    RING_7 = 7,
    RING_8 = 8,
    BODY   = 9,
    FRONT  = 10,
    ALL    = 11
}

struct RgbColor {
    r: ubyte;
    g: ubyte;
    b: ubyte;
}

table LedEntry {
    target: LedTarget = RING_1;
    on: bool = false;
    color: RgbColor;          // Used when target is RING_2, 4, 6, 8, or ALL
    intensity: ubyte = 100;   // 0..100
}

table SetLeds {
    entries: [LedEntry];
    fade_ms: uint16 = 0;
}

union Instruction {
    Custom,
    EnableCommand,
    MoveTrajectory,
    FileTransfer,
    PlaySound,
    SetLeds
}

// Needed since flatbuffers doesn't support vectors of unions.
table Command {
    command: Instruction;
}

table CommandBatch {
    timestamp: uint64;
    commands: [Command];
}

root_type CommandBatch;
